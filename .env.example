DATABASE_URL="file:./dev.db"

# Required. Must be at least 32 characters and unique to this deployment.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-this-with-a-unique-random-secret-at-least-32-characters"

# Local demo convenience only. Demo accounts are refused in production unless
# ALLOW_DEMO_IN_PRODUCTION=true is also set.
DEMO_MODE=true

# Protects the scheduled expiry endpoint /api/cron/expire.
# Use a random value of at least 16 characters.
CRON_SECRET="replace-with-a-unique-cron-secret-at-least-16-characters"
